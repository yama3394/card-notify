# ─────────────────────────────────────────────────────────────
# card-notify 設定サンプル。`cp .env.example .env` して各値を埋める。
# .env は絶対にコミットしない（.gitignore 済み）。
#
# 読み込み場所は環境変数 CARD_NOTIFY_ENV_FILE で上書き可能。
# 未指定なら「リポジトリ直下の .env」を読む。
# 本番運用では install.sh / deploy/*.service と同じ /var/lib/card-notify/card-notify.env
# に置き、権限 600 を推奨:
#   export CARD_NOTIFY_ENV_FILE=/var/lib/card-notify/card-notify.env
# ─────────────────────────────────────────────────────────────

# ── LINE Messaging API（LINE Developers で作成したチャンネル） ──
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── WebUI ログインパスワード（平文ではなくハッシュを入れる） ──
# 生成: python gen_password.py '好きなパスワード'
WEB_PASSWORD=

# ── Flask セッション署名鍵（推測不能なランダム値） ──
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── 任意設定（未指定ならデフォルト動作） ──
# データ/トークンの保存先ディレクトリ（デフォルト: リポジトリ直下 data/ ）
# CARD_NOTIFY_DATA_DIR=/var/lib/card-notify

# セッション有効期間（日）
# SESSION_LIFETIME_DAYS=7

# Secure Cookie を強制するか。HTTPS 終端済みなら true を推奨（既定 false）。
# /setup ウィザードで公開 URL に https を指定すると自動で true が書き込まれる。
# SESSION_COOKIE_SECURE=true

# ログイン試行ロックで信用するクライアント IP ヘッダ名（既定は空＝remote_addr のみ）。
# リバースプロキシが必ず上書きするヘッダだけを指定する。nginx 経由なら
# （deploy/nginx.conf.example は X-Real-IP を設定済み）以下を有効化:
# CARD_NOTIFY_TRUSTED_IP_HEADER=X-Real-IP

# 待受ポート（既定 5000）。同一サーバーに複数インスタンスを同居させる場合、
# インスタンスごとに別ポート・別 DATA_DIR・別 systemd ユニットにして使う。
# CARD_NOTIFY_PORT=5000

# ── 自動アップデート（任意・既定 OFF） ──
# 有効にすると更新タイマーが配信元を見て新版へ自動更新する。
# 信頼できる自分の配信元だけを指すこと。
# AUTO_UPDATE=true
# CARD_NOTIFY_UPDATE_FEED_URL=https://<配信ドメイン>

# WebUI の公開URL（setup.py が自動記録。手動で変える場合はここ）
# SITE_URL=https://card-notify.yama3394.uk
